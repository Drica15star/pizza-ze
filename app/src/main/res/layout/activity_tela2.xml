<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8EA">

    <!-- APP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#B71C1C"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍕"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardápio"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp" />

    </LinearLayout>


    <!-- CARDÁPIO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">


            <!-- ========================= -->
            <!-- PIZZA 1 - MARGHERITA -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/imgPizza1"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:src="@drawable/images__4_"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pizza Margherita" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtNome1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Margherita"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20" />

                    <TextView
                        android:id="@+id/txtIngredientes1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Molho de tomate, mussarela, manjericão e azeite."
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txtPreco1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 32,90"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#1B5E20"
                        android:padding="8dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- PIZZA 2 - CALABRESA -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/imgPizza2"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:src="@drawable/images__5_"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pizza Calabresa" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtNome2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calabresa"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20" />

                    <TextView
                        android:id="@+id/txtIngredientes2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Molho de tomate, mussarela, calabresa, cebola e orégano."
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txtPreco2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 34,90"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#1B5E20"
                        android:padding="8dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- PIZZA 3 - FRANGO -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/imgPizza3"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:src="@drawable/images__6_"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pizza de Frango com Catupiry" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtNome3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frango com Catupiry"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20" />

                    <TextView
                        android:id="@+id/txtIngredientes3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Molho de tomate, frango desfiado, catupiry e orégano."
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txtPreco3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 36,90"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#1B5E20"
                        android:padding="8dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>